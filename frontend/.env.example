# User Pool de Cognito "sistema-tikets" (tier LITE, gratuito)
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=us-east-1_KI7WfnGVS
VITE_COGNITO_CLIENT_ID=12ht3dooe7dtkgd0a1nstqf4r3

