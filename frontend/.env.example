# Copia este archivo a .env.local y completa con tus valores reales.
# .env.local NO debe subirse al repositorio.

# URL de PostgREST (docker/docker-compose.yml expone POSTGREST_PORT, por defecto 3000)
VITE_POSTGREST_URL=http://localhost:3000

# Datos de tu User Pool de Cognito
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
