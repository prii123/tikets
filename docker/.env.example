# Copia este archivo a .env (misma carpeta) y completa con valores reales.
# .env NO debe subirse al repositorio (contiene credenciales).

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIA_ESTA_CONTRASENA_SUPERUSER
POSTGRES_DB=tickets
POSTGRES_PORT=5432

# Contraseña real del rol "authenticator" (04_roles.sql lo crea con un
# placeholder; 09_set_passwords.sh la reemplaza por esta al iniciar).
AUTHENTICATOR_PASSWORD=CAMBIA_ESTA_CONTRASENA_AUTHENTICATOR

# --- PostgREST ---
POSTGREST_PORT=3000

# La llave pública de Cognito para validar el JWT (RS256) ya NO va aquí:
# vive en docker/postgrest-jwt-secret.json (un solo JWK, montado como
# archivo en el contenedor). Ver el comentario junto a PGRST_JWT_SECRET
# en docker-compose.yml para el porqué.

# Solo si validas el ID Token de Cognito (trae claim "aud")
# COGNITO_APP_CLIENT_ID=

# --- Frontend (React, servido por nginx en el contenedor "frontend") ---
FRONTEND_PORT=80

# El frontend corre en el navegador del usuario, así que debe apuntar a la
# IP/dominio PÚBLICO del backend, no a "postgrest" (nombre interno de Docker).
VITE_POSTGREST_URL=http://34.237.154.164:3000
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=us-east-1_KI7WfnGVS
VITE_COGNITO_CLIENT_ID=12ht3dooe7dtkgd0a1nstqf4r3

# Lambda Function URL que crea usuarios en Cognito (admin/agente la usan
# desde /admin/usuarios). Ver lambda/crear-usuario/.
VITE_CREAR_USUARIO_URL=https://ts6cvigeac3hy4i2yhppgvprim0oftxz.lambda-url.us-east-1.on.aws/
