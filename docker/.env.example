# COGNITO_APP_CLIENT_ID=

# --- Frontend (React, servido por nginx en el contenedor "frontend") ---
FRONTEND_PORT=80

# El frontend corre en el navegador del usuario, así que debe apuntar a la
# IP/dominio PÚBLICO del backend, no a "postgrest" (nombre interno de Docker).
VITE_POSTGREST_URL=http://34.237.154.164:3000
