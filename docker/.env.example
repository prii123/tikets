# Copia este archivo a .env (misma carpeta) y completa con valores reales.
# .env NO debe subirse al repositorio (contiene credenciales).

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIA_ESTA_CONTRASENA_SUPERUSER
POSTGRES_DB=tickets
POSTGRES_PORT=5432

# Contraseña real del rol "authenticator" (04_roles.sql lo crea con un
# placeholder; 09_set_passwords.sh la reemplaza por esta al iniciar).
AUTHENTICATOR_PASSWORD=CAMBIA_ESTA_CONTRASENA_AUTHENTICATOR

# --- PostgREST ---
POSTGREST_PORT=3000

# JWKS del User Pool "sistema-tikets" (us-east-1_KI7WfnGVS, tier LITE),
# FIJO como JSON (no como URL: PostgREST v14.13 falla al descargarlo él
# mismo). El nombre debe ser exactamente PGRST_JWT_SECRET: en
# docker-compose.yml se declara sin valor a propósito, para que Compose
# tome esto tal cual sin que el YAML lo reinterprete (el JSON tiene { }
# y comillas que romperían la sintaxis si se sustituyera como ${VAR}).
# Si Cognito rota sus llaves de firma, actualiza esto con:
#   curl https://cognito-idp.us-east-1.amazonaws.com/us-east-1_KI7WfnGVS/.well-known/jwks.json
